# Configuración del Entorno - VLFisioterapia · Centro de Fisioterapia y Rehabilitación
# (Clase 13 - Canales Gradio, Flowise y Telegram)

# 1. Credenciales de Telegram (Obtenidas mediante @BotFather en chat privado)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Clave privada compartida entre el bot de Telegram y FastAPI (mínimo 16 caracteres ASCII)
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHATBOT_API_KEY=clave_secreta_compartida_de_al_menos_16_caracteres_ascii

# 3. Dirección de la API del negocio (FastAPI)
CHATBOT_API_URL=http://127.0.0.1:8012

# 4. Proveedor de Inteligencia Artificial (Groq)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# 5. Configuración del servidor local (FastAPI / Uvicorn)
HOST=127.0.0.1
PORT=8012
